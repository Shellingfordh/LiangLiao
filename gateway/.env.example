# 只存在于网关部署平台的环境变量。任何值都不得进入 git、Lua、资源或日志。
# 模型 Key 全工程只在这一处（且这里是变量名，不是值）。

# OpenAI 兼容端点，例如 https://api.deepseek.com/v1
LLM_API_BASE=
# 模型 Key
LLM_API_KEY=
# 模型名，例如 deepseek-chat
LLM_MODEL=

# 调用方（Maker 服务端中继）鉴权密钥
GATEWAY_SHARED_SECRET=

# 监听端口（Serverless 平台通常会注入）
PORT=8788

# 限流与成本
RATE_LIMIT_PER_MIN=2
DAILY_TOKEN_BUDGET=30000
